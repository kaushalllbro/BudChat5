rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isApproved() {
      return signedIn() &&
        exists(/databases/$(database)/documents/meta/accounts) &&
        request.auth.uid in get(/databases/$(database)/documents/meta/accounts).data.uids;
    }

    // /meta/accounts — list of approved uids (max 3 enforced client-side via transaction)
    match /meta/accounts {
      allow read: if signedIn();
      // Only allow appending self, never removing others, never exceeding 3
      allow write: if signedIn()
        && request.resource.data.uids.size() <= 3
        && request.auth.uid in request.resource.data.uids;
    }

    // /users/{uid}
    match /users/{uid} {
      allow read: if isApproved();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;

      match /devices/{deviceId} {
        allow read, write, delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // /chats/{chatId} — chatId must be the two uids sorted and joined by "__"
    match /chats/{chatId} {
      function inChat() {
        return isApproved() &&
          (chatId.split('__')[0] == request.auth.uid || chatId.split('__')[1] == request.auth.uid);
      }
      allow read, write: if inChat();

      match /messages/{mid} {
        allow read: if inChat();
        allow create: if inChat() && request.resource.data.from == request.auth.uid;
        allow update, delete: if inChat();
      }
      match /typing/{uid} {
        allow read: if inChat();
        allow write: if inChat() && request.auth.uid == uid;
      }
    }

    // /calls
    match /calls/{callId} {
      allow read, write: if isApproved() && (request.auth.uid in resource.data.users || request.auth.uid in request.resource.data.users);
      match /{sub}/{candId} {
        allow read, write: if isApproved();
      }
    }

    // /notifications
    match /notifications/{nid} {
      allow read: if isApproved() && resource.data.to == request.auth.uid;
      allow create: if isApproved() && request.resource.data.from == request.auth.uid;
      allow delete: if isApproved() && resource.data.to == request.auth.uid;
    }
  }
}
